APP_ENV=local
APP_VERSION=1.0.0

# 业务时区：跨日补录与“今日新增”按此时区切日，换环境只改这里
BUSINESS_TZ=Asia/Shanghai

# 流水线状态目录（检查点、批次快照、发布指针、迁移登记）
PIPELINE_STATE_DIR=var/pipeline

# 部署前必须可用的缓存 / 队列依赖（逗号分隔）
# 本地默认文件型探针；staging/prod 换成 redis://host:port、amqp://host:port 等
REQUIRED_CACHE=file:var/cache
REQUIRED_QUEUE=file:var/queue

# 连接断开后的重试次数与退避基准秒
PIPELINE_RETRY=3
PIPELINE_RETRY_BACKOFF=0.2

# 允许的前端来源
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
