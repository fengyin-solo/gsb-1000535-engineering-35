# 运行环境：local / staging / prod
APP_ENV=local

# 业务时区：跨日补录、批次口径、汇总统计都按此时区切日（不依赖容器 TZ）
BUSINESS_TIMEZONE=Asia/Shanghai
# 流水线业务日期（不填时本地取业务时区当天）
BUSINESS_DATE=

# 流水线持久化目录：台账、快照、队列、缓存、检查点
DATA_DIR=./var/data
# 本地首次启动是否自动执行初始化流水线
AUTO_BOOTSTRAP=1

# 缓存/队列后端：local 用 file，staging/prod 用 redis
CACHE_BACKEND=file
QUEUE_BACKEND=file
REDIS_URL=redis://127.0.0.1:6379/0

# 部署前依赖探测：超时秒数 / 重试次数（连接断开复位后重试）
DEP_TIMEOUT_SECONDS=2
DEP_ATTEMPTS=3

# 种子版本（v1 内置示例 / v2 补时间戳 / v3 补关联参考码）
SEED_VERSION=v3
